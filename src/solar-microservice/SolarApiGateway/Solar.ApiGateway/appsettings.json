{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "identity-role-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/role/{**catch-all}" }
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/users/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": { "Path": "/notifications/{**catch-all}" }
      },
      "notification-route": {
        "ClusterId": "notifications-cluster",
        "Match": { "Path": "/notification/{**catch-all}" }
      },
      "claims-route": {
        "ClusterId": "notifications-cluster",
        "Match": { "Path": "/claims" }
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": { "Path": "/products/{**catch-all}" }
      },
      "product-images-route": {
        "ClusterId": "products-cluster",
        "Match": { "Path": "/productImages/{**catch-all}" }
      },
      "categories-route": {
        "ClusterId": "products-cluster",
        "Match": { "Path": "/categories/{**catch-all}" }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/cart/{**catch-all}" }
      },
      "cart-hub-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/carthub/{**catch-all}" }
      },
      "test-product-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/test-product/{**catch-all}" }
      },
      "test-products-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/test-products/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/orders/{**catch-all}" }
      },
      "order-hub-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/orderhub/{**catch-all}" }
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": { "Path": "/payments/{**catch-all}" }
      },
      "uploads-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/uploads/{**catch-all}"
        }
      },
      "invoices-route": {
        "ClusterId": "invoices-cluster",
        "Match": { "Path": "/invoices/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": { "Address": "http://localhost:7000/" }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications-api": { "Address": "http://localhost:7001/" }
        }
      },
      "products-cluster": {
        "Destinations": {
          "products-api": { "Address": "http://localhost:7003/" }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cart-api": { "Address": "http://localhost:7004/" }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders-api": { "Address": "http://localhost:7005/" }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "payments-api": { "Address": "http://localhost:7006/" }
        }
      },
      "invoices-cluster": {
        "Destinations": {
          "invoices-api": { "Address": "http://localhost:7007/" }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
